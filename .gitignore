# temp directory
.temp
.tmp

# perfumeCatalogImporter: source dataset (fetched via download_dataset.py, not
# committed — see perfumeCatalogImporter/data/README.md), any local
# embeddings/HNSW index files, and its own virtualenv.
perfumeCatalogImporter/data/*.csv
perfumeCatalogImporter/*.npz
perfumeCatalogImporter/*.hnsw
perfumeCatalogImporter/.venv/

# cosmic-ray mutation testing session DB (regenerated by `cosmic-ray init`/`exec`)
perfumeCatalogImporter/*.sqlite

# chatbot: personal local MCP config (point MCP_CONFIG_PATH at this instead
# of editing the committed mcp-servers.json, which config.spec.ts expects to
# stay `[]`) — same pattern as dev-mcp-stub/mcp-servers.dev.json, but for
# servers/ports specific to one dev's machine, not the disposable stub.
chatbot/mcp-servers.local.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Claude Code worktrees (see .worktreeinclude)
.claude/worktrees/

