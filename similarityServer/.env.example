# Local (non-Docker) development only. Copy to .env (gitignored); never commit .env.
# With Docker Compose use the ROOT .env.example instead — compose injects all of
# these into the containers.
#
# Renamed in the docker-infra feature (old -> new):
#   EMBEDDINGS_PATH -> SIMILARITY_EMBEDDINGS_PATH   HOST -> SIMILARITY_HOST
#   PORT -> SIMILARITY_PORT                         LOG_LEVEL -> SIMILARITY_LOG_LEVEL
#   MCP_MOUNT_PATH -> SIMILARITY_MCP_MOUNT_PATH     DATASET_CSV_PATH -> SIMILARITY_DATASET_CSV_PATH

# --- download_dataset.py (manual Kaggle refresh) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- shared by main.py (CLI catalog importer) and app.py (FastAPI search server) ---
# Same Postgres instance the backend uses — see backend/.env.example.
DATABASE_URL=postgresql://mario_da_parfums:mario_da_parfums@localhost:5432/mario_da_parfums
# Optional — defaults shown:
# SIMILARITY_LOG_LEVEL=info

# --- main.py / config.py (CLI importer) ---
# SIMILARITY_DATASET_CSV_PATH=similarityServer/data/perfumes_dataset.csv

# --- app.py / server_config.py (FastAPI similarity-search server) ---
# Optional — defaults shown:
# SIMILARITY_EMBEDDINGS_PATH=similarityServer/embeddings.npz
# SIMILARITY_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# SIMILARITY_HOST=0.0.0.0
# SIMILARITY_PORT=8001
# SIMILARITY_MCP_MOUNT_PATH=/mcp
# Origin allowed by CORS (the browser calls /search directly). Same name/value as
# the backend's FRONTEND_URL. Default: http://localhost:3010
# FRONTEND_URL=http://localhost:3010
