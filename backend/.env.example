# Local (non-Docker) development only. Copy to .env (gitignored).
# Full stack via Docker: use the ROOT .env.example + docker-compose.yml instead.
# Start only the database from the repo root: `docker compose up -d postgres`

# Postgres credentials — must match the root .env / docker-compose.yml defaults
POSTGRES_USER=mario_da_parfums
POSTGRES_PASSWORD=mario_da_parfums
POSTGRES_DB=mario_da_parfums

# Connection string used by Drizzle (drizzle.config.ts and DatabaseModule)
DATABASE_URL=postgresql://mario_da_parfums:mario_da_parfums@localhost:5432/mario_da_parfums

# [SECRET] Signs session JWTs. Required: without it auth breaks at runtime.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Exact origin of the frontend (CORS allow-list, credentials enabled).
# Default if unset: http://localhost:3010 — a mismatch fails silently in the browser.
FRONTEND_URL=http://localhost:3010
# API port (default 3000)
# PORT=3000
