# Root environment for `docker compose` (the whole stack). Copy to .env and edit:
#   cp .env.example .env
# .env is gitignored — never commit it. Secrets are marked [SECRET].
# Every value below has a working local default in docker-compose.yml except
# JWT_SECRET (required) and GEMINI_API_KEY (needed for the chatbot).
# For running services outside Docker, use each package's own .env.example.

# ===== Postgres (compose creates the DB with these; DATABASE_URL is derived) =====
POSTGRES_USER=mario_da_parfums
POSTGRES_PASSWORD=mario_da_parfums   # [SECRET] change outside local dev; keep it URL-safe (no @ : / ? # %)
POSTGRES_DB=mario_da_parfums
# Host port for the DB (loopback only). Change it if 5432 is already taken.
POSTGRES_HOST_PORT=5432

# ===== Backend (NestJS) =====
JWT_SECRET=change-me-to-a-long-random-string   # [SECRET] required; e.g. `openssl rand -hex 32`
JWT_EXPIRES_IN=15m
# `production` => Secure session cookie + HSTS. Set to `development` only if you
# open the site from a plain-http host other than localhost (e.g. a LAN IP).
BACKEND_NODE_ENV=production
BACKEND_HOST_PORT=3000

# ===== Public URLs (as seen by the BROWSER, not Docker-internal names) =====
# FRONTEND_URL: exact origin in the browser's address bar. Used for CORS by the
# backend and the similarity server; a mismatch makes login/search fail silently.
FRONTEND_URL=http://localhost:3010
FRONTEND_HOST_PORT=3010
# NEXT_PUBLIC_* are baked into the frontend bundle at build time:
# after changing them run `docker compose build frontend`.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3000
NEXT_PUBLIC_QUERY_API_URL=http://localhost:8001
NEXT_PUBLIC_CHATBOT_WS_URL=ws://localhost:8081

# ===== similarityServer (FastAPI semantic search + MCP) =====
SIMILARITY_HOST_PORT=8001
# Embedding model baked into the image at build; changing it downloads it on first start
# and forces a full re-index (delete the similarity_data volume).
SIMILARITY_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_LOG_LEVEL=info

# ===== Chatbot (WebSocket + Gemini) =====
GEMINI_API_KEY=   # [SECRET] https://aistudio.google.com/apikey
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_CLASSIFIER_FALLBACK_MODEL=gemini-3.1-flash-lite
CHATBOT_HOST_PORT=8081

# ===== Optional jobs =====
# Only for `docker compose --profile tools run --rm download-dataset` (Kaggle API token).
KAGGLE_USERNAME=
KAGGLE_KEY=   # [SECRET]
# uid/gid the download job runs as, so the CSV lands owned by you (`id -u`, `id -g`).
LOCAL_UID=1000
LOCAL_GID=1000
PRICE_GENERATOR_LOG_LEVEL=INFO
