# Single environment file for the whole repo. Copy to .env and edit:
#   cp .env.example .env
# .env is gitignored — never commit it. Secrets are marked [SECRET].
#
# It serves BOTH ways of running the project:
#   1. Docker Compose (the whole stack): compose reads it from the repo root.
#   2. Host development without Docker (pnpm dev / python -m ...): backend,
#      chatbot, frontend and similarityServer each load THIS same file from the
#      repo root. It is optional for them (inside Docker images it does not
#      exist) and real environment variables always win over it.
# Per-package .env files are NOT read anymore (see docs/local-setup.md,
# "Migrar desde .env por paquete"). Check your file against this template with
#   node scripts/check-env.mjs
#
# Every value in sections 1-5 has a working local default in docker-compose.yml
# except JWT_SECRET (required) and GEMINI_API_KEY (needed for the chatbot).
# Keep comments on their own line: a comment after a value (especially an
# empty one) is read as part of the value by Compose.

# ===== 1. Postgres (compose creates the DB with these; DATABASE_URL is derived) =====
POSTGRES_USER=mario_da_parfums
# [SECRET] change outside local dev; keep it URL-safe (no @ : / ? # %)
POSTGRES_PASSWORD=mario_da_parfums
POSTGRES_DB=mario_da_parfums
# Host port for the DB (loopback only). Change it if 5432 is already taken.
POSTGRES_HOST_PORT=5432

# ===== 2. Backend (NestJS) =====
# [SECRET] required; e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
# `production` => Secure session cookie + HSTS. Set to `development` only if you
# open the site from a plain-http host other than localhost (e.g. a LAN IP).
# Docker only: compose passes it to the container as NODE_ENV.
BACKEND_NODE_ENV=production
BACKEND_HOST_PORT=3000

# ===== 3. Public URLs (as seen by the BROWSER, not Docker-internal names) =====
# FRONTEND_URL: exact origin in the browser's address bar. Used for CORS by the
# backend and the similarity server; a mismatch makes login/search fail silently.
FRONTEND_URL=http://localhost:3010
FRONTEND_HOST_PORT=3010
# NEXT_PUBLIC_* are baked into the frontend bundle at build time:
# Docker: after changing them run `docker compose build frontend`.
# Host: `next dev` / `next build` read them from this file.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3000
NEXT_PUBLIC_QUERY_API_URL=http://localhost:8001
NEXT_PUBLIC_CHATBOT_WS_URL=ws://localhost:8081

# ===== 4. similarityServer (FastAPI semantic search + MCP) =====
# Loopback only (no auth on /mcp and /search).
SIMILARITY_HOST_PORT=8001
# Embedding model baked into the image at build; changing it downloads it on first start
# and forces a full re-index (delete the similarity_data volume).
SIMILARITY_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_LOG_LEVEL=info

# ===== 5. Chatbot (WebSocket + Gemini) =====
# [SECRET] https://aistudio.google.com/apikey. Leave the value EMPTY (no inline comment
# after it: Compose would read the comment as the value).
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_CLASSIFIER_FALLBACK_MODEL=gemini-3.1-flash-lite
# Loopback only (no auth on the WebSocket; uses your Gemini quota).
CHATBOT_HOST_PORT=8081

# ===== 6. Optional jobs =====
# Only for `docker compose --profile tools run --rm download-dataset` or
# `python -m similarityServer.download_dataset` (one Kaggle API token).
# [SECRET] Create it at kaggle.com/settings -> API -> Create New Token.
SIMILARITY_KAGGLE_API_TOKEN=
# uid/gid the download job runs as, so the CSV lands owned by you (`id -u`, `id -g`).
LOCAL_UID=1000
LOCAL_GID=1000
PRICE_GENERATOR_LOG_LEVEL=INFO

# ===== 7. HOST-ONLY (services run outside Docker) =====
# Docker Compose IGNORES everything in this section: it builds its own values
# for these variables (DATABASE_URL, PORT, SIMILARITY_HOST/PORT, CHATBOT_WS_*,
# MCP_CONFIG_PATH) in docker-compose.yml. Start only the database for host
# work with: docker compose up -d postgres
#
# Connection string for backend (Drizzle), similarityServer and db:* scripts.
# Same credentials and port as section 1 (host = localhost, port =
# POSTGRES_HOST_PORT). Not interpolated: edit it by hand if you change section 1.
# Uncomment it only for host development (Docker does not need it).
# DATABASE_URL=postgresql://mario_da_parfums:mario_da_parfums@localhost:5432/mario_da_parfums
# Backend listen port (default 3000). Host counterpart of BACKEND_HOST_PORT.
# PORT=3000
# Chatbot WebSocket bind address and port (defaults 0.0.0.0 / 8081). The port
# is the host counterpart of CHATBOT_HOST_PORT and must match
# NEXT_PUBLIC_CHATBOT_WS_URL.
# CHATBOT_WS_HOST=0.0.0.0
# CHATBOT_WS_PORT=8081
# Declarative MCP servers list, relative to chatbot/ (default ./mcp-servers.json).
# Point it at dev-mcp-stub/mcp-servers.dev.json to exercise the tool-calling loop
# against the throwaway stub; Docker uses ./mcp-servers.docker.json.
# MCP_CONFIG_PATH=./mcp-servers.json
# similarityServer listen address (defaults 0.0.0.0 / 8001; must match
# NEXT_PUBLIC_QUERY_API_URL) and optional paths/mount (defaults shown).
# SIMILARITY_HOST=0.0.0.0
# SIMILARITY_PORT=8001
# SIMILARITY_MCP_MOUNT_PATH=/mcp
# SIMILARITY_EMBEDDINGS_PATH=similarityServer/embeddings.npz
# SIMILARITY_DATASET_CSV_PATH=similarityServer/data/perfumes_dataset.csv
# Chatbot tuning (defaults shown): complete turns of history kept per part, cap
# on the tool-calling loop per turn, and the out-of-scope copy.
# CHATBOT_AGENT_HISTORY_TURNS=12
# CHATBOT_CLASSIFIER_HISTORY_TURNS=4
# CHATBOT_MAX_TOOL_ITERATIONS=8
# CHATBOT_REJECTION_MESSAGE=Solo puedo ayudarte con preguntas sobre perfumes: catálogo, precios, disponibilidad y comparaciones entre vendors. ¿Querés preguntarme algo sobre eso?
