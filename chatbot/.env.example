# Gemini API key — shared by the main agent and the stage-1 scope classifier
# (see specs/chatbot-server.md, "Configuración"). Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Model used by the main tool-calling agent (stage 2). If a call with this
# model fails (e.g. a retired/unavailable model id), it's retried once,
# transparently, with GEMINI_AGENT_FALLBACK_MODEL — see src/gemini/model-fallback.ts.
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT_FALLBACK_MODEL=gemini-3.1-flash-lite

# Model used by the stage-1 scope classifier. Same fallback behavior as the
# agent model above.
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_CLASSIFIER_FALLBACK_MODEL=gemini-3.1-flash-lite

# WebSocket server bind address.
CHATBOT_WS_HOST=0.0.0.0
CHATBOT_WS_PORT=8081

# How many complete turns of history each part of the system keeps.
# A "turn" is one user message through to the agent's final answer (including
# any tool-calling round-trips in between) — never truncated mid-turn.
CHATBOT_AGENT_HISTORY_TURNS=12
CHATBOT_CLASSIFIER_HISTORY_TURNS=4

# Safety cap on the tool-calling loop per turn (function_call -> function
# response -> call Gemini again). If exceeded, the turn ends in an error
# instead of looping indefinitely.
CHATBOT_MAX_TOOL_ITERATIONS=8

# Fixed copy returned when the stage-1 guardrail marks a message out of scope.
# This is just copy, not business logic — safe to reword freely.
CHATBOT_REJECTION_MESSAGE="Solo puedo ayudarte con preguntas sobre perfumes: catálogo, precios, disponibilidad y comparaciones entre vendors. ¿Querés preguntarme algo sobre eso?"

# Path (relative to chatbot/) to the declarative MCP servers config — see
# mcp-servers.json. Point this at dev-mcp-stub/mcp-servers.dev.json to
# exercise the tool-calling loop locally against the throwaway stub server.
MCP_CONFIG_PATH=./mcp-servers.json
