# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- download_dataset.py (manual Kaggle refresh) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- main.py / config.py (CLI importer) ---
# Same DATABASE_URL as below.
# Optional — defaults shown:
# DATASET_CSV_PATH=perfumeCatalogImporter/data/perfumes_dataset.csv
# LOG_LEVEL=info

# --- app.py / server_config.py (FastAPI similarity-search server) ---
# Same Postgres instance the backend uses — see backend/.env.example.
DATABASE_URL=postgresql://mario_da_parfums:mario_da_parfums@localhost:5432/mario_da_parfums
# Optional — defaults shown:
# EMBEDDINGS_PATH=perfumeCatalogImporter/embeddings.npz
# SIMILARITY_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# HOST=0.0.0.0
# PORT=8001
# LOG_LEVEL=info
# MCP_MOUNT_PATH=/mcp
